config("httplib_config") {
  defines = [
    "CPPHTTPLIB_NO_EXCEPTIONS",
    "CPPHTTPLIB_ZLIB_SUPPORT",
    "CPPHTTPLIB_OPENSSL_SUPPORT",
  ]
}

source_set("httplib") {
  sources = [
    "httplib.cc",
    "httplib.h",
  ]

  public_deps = [
    "../boringssl",
    "//third_party/zlib",
  ]

  if (is_linux) {
    libs = [ "anl" ]
  } else if (is_mac) {
    frameworks = [
      "CFNetwork.framework",
    ]
  }

  public_configs = [ ":httplib_config" ]
}
